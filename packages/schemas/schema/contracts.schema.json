{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-conductor.dev/schema/contracts.schema.json",
  "title": "Code Conductor Contracts",
  "$defs": {
    "RiskClass": { "type": "string", "enum": ["R0", "R1", "R2", "R3", "R4"] },
    "Stance": { "type": "string", "enum": ["constructive", "critical", "neutral"] },
    "BillingChannel": { "type": "string", "enum": ["subscription", "api", "manual", "local"] },
    "TaskEnvelope": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "objective", "acceptanceCriteria", "risk", "constraints", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "objective": { "type": "string", "minLength": 1 }, "repository": { "type": "string" },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } }, "risk": { "$ref": "#/$defs/RiskClass" },
        "constraints": { "type": "array", "items": { "type": "string" } }, "specializations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "AgentAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "taskId", "agentId", "role", "stance", "provider", "harness", "billingChannel", "authority", "dependsOn"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "taskId": { "type": "string", "minLength": 1 }, "agentId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }, "stance": { "$ref": "#/$defs/Stance" }, "provider": { "type": "string", "minLength": 1 },
        "harness": { "type": "string", "minLength": 1 }, "surface": { "type": "string", "minLength": 1 }, "billingChannel": { "$ref": "#/$defs/BillingChannel" },
        "authority": { "type": "array", "items": { "type": "string" } }, "dependsOn": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Evidence": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "source", "summary"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "type": "string", "enum": ["repository", "test", "documentation", "tool", "human", "agent_output", "other"] }, "source": { "type": "string" }, "summary": { "type": "string" }, "uri": { "type": "string" }, "sha256": { "type": "string" } }
    },
    "Finding": {
      "type": "object", "additionalProperties": false, "required": ["id", "severity", "summary", "evidenceIds", "blocking"],
      "properties": { "id": { "type": "string" }, "severity": { "type": "string", "enum": ["info", "low", "medium", "high", "critical"] }, "summary": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } }, "blocking": { "type": "boolean" } }
    },
    "GateResult": {
      "type": "object", "additionalProperties": false, "required": ["gate", "status", "evidenceIds"],
      "properties": { "gate": { "type": "string" }, "status": { "type": "string", "enum": ["passed", "failed", "skipped"] }, "evidenceIds": { "type": "array", "items": { "type": "string" } }, "summary": { "type": "string" } }
    },
    "AgentResult": {
      "type": "object", "additionalProperties": false,
      "required": ["taskId", "assignmentId", "agentId", "role", "stance", "provider", "harness", "billingChannel", "status", "changes", "tests", "evidence", "findings", "risks", "blockers", "recommendation"],
      "properties": {
        "taskId": { "type": "string" }, "assignmentId": { "type": "string" }, "agentId": { "type": "string" }, "role": { "type": "string" }, "stance": { "$ref": "#/$defs/Stance" }, "provider": { "type": "string" }, "harness": { "type": "string" }, "surface": { "type": "string", "minLength": 1 }, "billingChannel": { "$ref": "#/$defs/BillingChannel" },
        "status": { "type": "string", "enum": ["completed", "awaiting_external", "blocked", "failed", "cancelled"] }, "changes": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/GateResult" } }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/Evidence" } }, "findings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        "risks": { "type": "array", "items": { "type": "string" } }, "blockers": { "type": "array", "items": { "type": "string" } },
        "recommendation": { "type": "string", "enum": ["continue", "review", "changes_required", "ready", "human_required"] },
        "notVerified": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "ReviewResult": {
      "type": "object", "additionalProperties": false, "required": ["reviewerAgentId", "verdict", "findingIds", "evidenceIds"],
      "properties": { "reviewerAgentId": { "type": "string" }, "verdict": { "type": "string", "enum": ["approve", "changes_requested", "comment"] }, "findingIds": { "type": "array", "items": { "type": "string" } }, "evidenceIds": { "type": "array", "items": { "type": "string" } } }
    },
    "MergeDecision": {
      "type": "object", "additionalProperties": false, "required": ["decision", "rationale", "evidenceIds"],
      "properties": { "decision": { "type": "string", "enum": ["ready", "changes_required", "human_required", "blocked"] }, "rationale": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } } }
    },
    "ApprovalRecord": {
      "type": "object", "additionalProperties": false, "required": ["requestDigest", "action", "runId", "taskId", "revision", "status", "approver", "requestedAt", "summary"],
      "properties": { "requestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "action": { "type": "string", "enum": ["local_execution", "context_disclosure", "commit", "deployment"] }, "runId": { "type": "string", "minLength": 1 }, "taskId": { "type": "string", "minLength": 1 }, "assignmentId": { "type": "string", "minLength": 1 }, "recipient": { "type": "string", "minLength": 1 }, "revision": { "type": "string", "minLength": 1 }, "status": { "type": "string", "enum": ["approved", "denied", "missing", "expired", "changed"] }, "approver": { "type": "string", "minLength": 1 }, "requestedAt": { "type": "string", "format": "date-time" }, "decidedAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" }, "summary": { "type": "string" } }
    },
    "HandoffParty": {
      "type": "object", "additionalProperties": false, "required": ["assignmentId", "agentId", "role", "provider", "harness"],
      "properties": { "assignmentId": { "type": "string", "minLength": 1 }, "agentId": { "type": "string", "minLength": 1 }, "role": { "type": "string", "minLength": 1 }, "provider": { "type": "string", "minLength": 1 }, "harness": { "type": "string", "minLength": 1 }, "surface": { "type": "string" } }
    },
    "Disagreement": {
      "type": "object", "additionalProperties": false, "required": ["topic", "status", "positions"],
      "properties": { "topic": { "type": "string", "minLength": 1 }, "status": { "const": "unresolved" }, "positions": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["agentId", "role", "stance", "recommendation", "evidenceIds"], "properties": { "agentId": { "type": "string" }, "role": { "type": "string" }, "stance": { "$ref": "#/$defs/Stance" }, "recommendation": { "type": "string", "enum": ["continue", "review", "changes_required", "ready", "human_required"] }, "evidenceIds": { "type": "array", "items": { "type": "string" } } } } } }
    },
    "HandoffPacket": {
      "type": "object", "additionalProperties": false, "required": ["version", "id", "runId", "taskId", "from", "to", "createdAt", "expiresAt", "context", "priorFindings", "disagreements", "provenance"],
      "properties": {
        "version": { "const": 1 }, "id": { "type": "string", "pattern": "^HP-[A-Za-z0-9-]{8,80}$" }, "runId": { "type": "string", "minLength": 1 }, "taskId": { "type": "string", "minLength": 1 },
        "from": { "type": "array", "items": { "$ref": "#/$defs/HandoffParty" } }, "to": { "$ref": "#/$defs/HandoffParty" },
        "createdAt": { "type": "string", "format": "date-time" }, "expiresAt": { "type": "string", "format": "date-time" },
        "context": { "type": "object", "additionalProperties": false, "required": ["objective", "acceptanceCriteria", "constraints", "reportedChanges", "notVerified", "risks"], "properties": { "objective": { "type": "string" }, "acceptanceCriteria": { "type": "array", "items": { "type": "string" } }, "constraints": { "type": "array", "items": { "type": "string" } }, "reportedChanges": { "type": "array", "items": { "type": "string" } }, "notVerified": { "type": "array", "items": { "type": "string" } }, "risks": { "type": "array", "items": { "type": "string" } } } },
        "priorFindings": { "type": "array", "items": { "$ref": "#/$defs/Finding" } },
        "disagreements": { "type": "array", "items": { "$ref": "#/$defs/Disagreement" } },
        "provenance": { "type": "object", "additionalProperties": false, "required": ["repository", "revision", "tree", "evidenceIds"], "properties": { "repository": { "type": "string" }, "revision": { "type": "string" }, "tree": { "type": "string" }, "evidenceIds": { "type": "array", "items": { "type": "string" } } } }
      }
    },
    "HandoffReference": {
      "type": "object", "additionalProperties": false, "required": ["id", "to", "sha256", "expiresAt"],
      "properties": { "id": { "type": "string", "pattern": "^HP-[A-Za-z0-9-]{8,80}$" }, "to": { "type": "string", "minLength": 1 }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "expiresAt": { "type": "string", "format": "date-time" } }
    },
    "WorktreeRecord": {
      "type": "object", "additionalProperties": false, "required": ["assignmentId", "path", "branch", "baseSha"],
      "properties": { "assignmentId": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1 }, "branch": { "type": "string", "minLength": 1 }, "baseSha": { "type": "string", "pattern": "^[a-f0-9]{40,64}$" } }
    },
    "RunManifest": {
      "type": "object", "additionalProperties": false, "required": ["runId", "task", "assignments", "results", "gates"],
      "properties": { "runId": { "type": "string" }, "task": { "$ref": "#/$defs/TaskEnvelope" }, "assignments": { "type": "array", "items": { "$ref": "#/$defs/AgentAssignment" } }, "results": { "type": "array", "items": { "$ref": "#/$defs/AgentResult" } }, "gates": { "type": "array", "items": { "$ref": "#/$defs/GateResult" } }, "approvals": { "type": "array", "items": { "$ref": "#/$defs/ApprovalRecord" } }, "worktrees": { "type": "array", "items": { "$ref": "#/$defs/WorktreeRecord" } }, "handoffs": { "type": "array", "items": { "$ref": "#/$defs/HandoffReference" } }, "mergeDecision": { "$ref": "#/$defs/MergeDecision" } }
    },
    "PlainName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "NonEmptyStrings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "GateCatalog": {
      "type": "object", "additionalProperties": false, "required": ["version", "profiles"],
      "properties": {
        "version": { "const": 1 }, "default_timeout_ms": { "type": "integer", "minimum": 1 },
        "profiles": { "type": "object", "propertyNames": { "$ref": "#/$defs/PlainName" }, "additionalProperties": { "$ref": "#/$defs/GateProfile" } }
      }
    },
    "GateProfile": {
      "type": "object", "additionalProperties": false, "required": ["gates"],
      "properties": {
        "selection": { "enum": ["detected", "explicit"] }, "replaces": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/PlainName" } },
        "detect": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": { "package_name": { "type": "string", "minLength": 1 }, "all_files": { "$ref": "#/$defs/NonEmptyStrings" }, "any_file": { "$ref": "#/$defs/NonEmptyStrings" }, "any_glob": { "$ref": "#/$defs/NonEmptyStrings" } }
        },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/GateDefinition" } }
      }
    },
    "GateDefinition": {
      "type": "object", "additionalProperties": false, "required": ["id", "command"],
      "properties": {
        "id": { "$ref": "#/$defs/PlainName" }, "command": { "type": "string", "minLength": 1 }, "args": { "type": "array", "items": { "type": "string" } },
        "blocking": { "type": "boolean" }, "timeout_ms": { "type": "integer", "minimum": 1 },
        "requires": {
          "type": "object", "additionalProperties": false,
          "properties": { "commands": { "$ref": "#/$defs/NonEmptyStrings" }, "paths": { "$ref": "#/$defs/NonEmptyStrings" }, "any_paths": { "$ref": "#/$defs/NonEmptyStrings" } }
        },
        "remediation": { "type": "string", "minLength": 1 }, "disclosure": { "type": "string", "minLength": 1 }
      }
    }
  }
}
