{
  "name": "code-conductor-vscode",
  "displayName": "Code Conductor",
  "description": "VS Code cockpit for the Code Conductor multi-provider agent engineering team.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "vscode": "^1.105.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B1220",
    "theme": "dark"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:codeConductor.runs",
    "onCommand:codeConductor.doctor"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "dist/ccon.js",
    "defaults/*.yaml",
    "defaults/manifest.json",
    "schema/contracts.schema.json",
    "media/conductor.svg",
    "media/icon.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Process discovery and execution are disabled until native Workspace Trust is granted."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "codeConductor.refresh",
        "title": "Code Conductor: Refresh Local Discovery",
        "icon": "$(refresh)"
      },
      {
        "command": "codeConductor.refreshRuns",
        "title": "Code Conductor: Refresh Runs",
        "icon": "$(refresh)"
      },
      {
        "command": "codeConductor.doctor",
        "title": "Code Conductor: Doctor",
        "icon": "$(heart)"
      },
      {
        "command": "codeConductor.validate",
        "title": "Code Conductor: Validate Repository",
        "icon": "$(verified)"
      },
      {
        "command": "codeConductor.plan",
        "title": "Code Conductor: Plan Task",
        "icon": "$(add)"
      },
      {
        "command": "codeConductor.openDecisions",
        "title": "Code Conductor: Open Decision Register",
        "icon": "$(book)"
      },
      {
        "command": "codeConductor.nextActions",
        "title": "Code Conductor: Show Next Actions for Run"
      },
      {
        "command": "codeConductor.performAction",
        "title": "Code Conductor: Perform Next Action"
      },
      {
        "command": "codeConductor.openRun",
        "title": "Code Conductor: Open Run Summary"
      },
      {
        "command": "codeConductor.openFile",
        "title": "Code Conductor: Open Configuration File"
      },
      {
        "command": "codeConductor.signIn",
        "title": "Code Conductor: Official Sign-in Guidance"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeConductor",
          "title": "Code Conductor",
          "icon": "media/conductor.svg"
        }
      ]
    },
    "views": {
      "codeConductor": [
        {
          "id": "codeConductor.runs",
          "name": "Runs",
          "icon": "media/conductor.svg",
          "contextualTitle": "Code Conductor runs"
        },
        {
          "id": "codeConductor.workstation",
          "name": "Workstation",
          "icon": "media/conductor.svg",
          "contextualTitle": "Code Conductor workstation"
        },
        {
          "id": "codeConductor.policy",
          "name": "Policy",
          "icon": "media/conductor.svg",
          "contextualTitle": "Code Conductor policy",
          "visibility": "collapsed"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "codeConductor.plan",
          "when": "view == codeConductor.runs",
          "group": "navigation@1"
        },
        {
          "command": "codeConductor.refreshRuns",
          "when": "view == codeConductor.runs",
          "group": "navigation@2"
        },
        {
          "command": "codeConductor.doctor",
          "when": "view == codeConductor.workstation",
          "group": "navigation@1"
        },
        {
          "command": "codeConductor.refresh",
          "when": "view == codeConductor.workstation",
          "group": "navigation@2"
        },
        {
          "command": "codeConductor.openDecisions",
          "when": "view == codeConductor.policy",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "codeConductor.nextActions",
          "when": "view == codeConductor.runs && viewItem == run",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "codeConductor.nextActions",
          "when": "false"
        },
        {
          "command": "codeConductor.performAction",
          "when": "false"
        },
        {
          "command": "codeConductor.openRun",
          "when": "false"
        },
        {
          "command": "codeConductor.openFile",
          "when": "false"
        },
        {
          "command": "codeConductor.signIn",
          "when": "false"
        },
        {
          "command": "codeConductor.refreshRuns",
          "when": "false"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeConductor.runs",
        "contents": "Open a repository folder to use Code Conductor.\n[Open Folder](command:vscode.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "codeConductor.runs",
        "contents": "No runs yet. A run plans the roles a task needs, isolates the change in a worktree, has it reviewed, runs the deterministic gates and records the evidence.\n[Plan a Task](command:codeConductor.plan)\n\nExecuting a run happens in a terminal with `ccon run … --execute`, where each consequential step asks for your approval.",
        "when": "workbenchState != empty && !codeConductor.hasRuns"
      },
      {
        "view": "codeConductor.workstation",
        "contents": "This workspace is in Restricted Mode. Code Conductor discovers clients and runs processes only in a trusted workspace.\n[Manage Workspace Trust](command:workbench.trust.manage)",
        "when": "!isWorkspaceTrusted"
      }
    ]
  },
  "dependencies": {
    "@code-conductor/git": "0.1.0",
    "@code-conductor/policy": "0.1.0",
    "@code-conductor/runtime": "0.1.0",
    "@code-conductor/schemas": "0.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/vscode": "~1.105.0"
  }
}
